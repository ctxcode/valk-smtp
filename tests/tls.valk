use smtp

// Settings that trust the fake server's own certificate
fn fake_tls_config(fake: FakeServer, security: smtp.Security) smtp.Config {
    let config = fake_config(fake)
    config.host = "localhost"
    config.security = security
    config.tls = .{ ca_file: test_cert() }
    return config
}

test "TLS: STARTTLS" {
    let fake = fake_server()
    fake.starttls = true
    let running = co serve(fake)
    let config = fake_tls_config(fake, smtp.Security.starttls)
    config.username = "ada@example.com"
    config.password = "secret"
    let client = smtp.connect_with(config) ! { println(E.message) assert(false) return }
    assert(client.tls_active)
    assert(client.authenticated)
    // STARTTLS is not offered again once the connection is private
    assert(!client.has_extension("STARTTLS"))
    client.send(simple_message()) ! { println(E.message) assert(false) return }
    client.close()
    assert(await running == "ok")

    let expected = "S: 220 fake.test ESMTP ready
C: EHLO client.test
S: 250-fake.test
S: 250-SIZE 1000000
S: 250-AUTH PLAIN LOGIN
S: 250-8BITMIME
S: 250 STARTTLS
C: STARTTLS
S: 220 2.0.0 Ready to start TLS
C: EHLO client.test
S: 250-fake.test
S: 250-SIZE 1000000
S: 250-AUTH PLAIN LOGIN
S: 250 8BITMIME
C: AUTH PLAIN AGFkYUBleGFtcGxlLmNvbQBzZWNyZXQ=
S: 235 2.7.0 Authentication successful
C: MAIL FROM:"
    assert(fake.transcript().starts_with(expected))
    assert(fake.messages.length == 1)
}

test "TLS: STARTTLS is required unless it is optional" {
    let fake = fake_server()
    let running = co serve(fake)
    smtp.connect_with(fake_tls_config(fake, smtp.Security.starttls)) ! {
        assert(error_is(E.code, tls))
        assert(E.message.contains("does not offer STARTTLS"))
        await running
        // Nothing past EHLO was said
        assert(!fake.transcript().contains("MAIL"))
        return
    }
    assert(false)
}

test "TLS: optional STARTTLS goes on without it" {
    let fake = fake_server()
    let running = co serve(fake)
    let client = smtp.connect_with(fake_tls_config(fake, smtp.Security.starttls_optional)) ! { println(E.message) assert(false) return }
    assert(!client.tls_active)
    client.send(simple_message()) ! { println(E.message) assert(false) return }
    client.close()
    assert(await running == "ok")
    assert(fake.messages.length == 1)
}

test "TLS: optional STARTTLS uses it when offered" {
    let fake = fake_server()
    fake.starttls = true
    let running = co serve(fake)
    let client = smtp.connect_with(fake_tls_config(fake, smtp.Security.starttls_optional)) ! { println(E.message) assert(false) return }
    assert(client.tls_active)
    client.close()
    assert(await running == "ok")
}

test "TLS: implicit TLS" {
    let fake = fake_server()
    fake.implicit_tls = true
    let running = co serve(fake)
    let config = fake_tls_config(fake, smtp.Security.tls)
    config.username = "ada@example.com"
    config.password = "secret"
    config.auth = smtp.AuthMethod.login
    let client = smtp.connect_with(config) ! { println(E.message) assert(false) return }
    assert(client.tls_active)
    assert(client.authenticated)
    client.send(simple_message()) ! { println(E.message) assert(false) return }
    client.close()
    assert(await running == "ok")
    assert(fake.transcript().starts_with("S: 220 fake.test ESMTP ready\nC: EHLO client.test\n"))
    assert(fake.transcript().contains("C: YWRhQGV4YW1wbGUuY29t\n"))
    assert(fake.messages.length == 1)
}

test "TLS: an untrusted certificate is refused" {
    let fake = fake_server()
    fake.implicit_tls = true
    let running = co serve(fake)
    let config = fake_config(fake)
    config.host = "localhost"
    config.security = smtp.Security.tls
    smtp.connect_with(config) ! {
        assert(error_is(E.code, tls))
        assert(E.message.contains("certificate"))
        await running
        return
    }
    assert(false)
}

test "TLS: no verification" {
    let fake = fake_server()
    fake.implicit_tls = true
    let running = co serve(fake)
    let config = fake_config(fake)
    config.security = smtp.Security.tls
    config.tls = .{ verify: false }
    let client = smtp.connect_with(config) ! { println(E.message) assert(false) return }
    assert(client.tls_active)
    client.close()
    assert(await running == "ok")
}

test "TLS: no password without TLS" {
    let fake = fake_server()
    let running = co serve(fake)
    let config = fake_config(fake)
    config.username = "ada@example.com"
    config.password = "secret"
    smtp.connect_with(config) ! {
        assert(error_is(E.code, auth))
        assert(E.message.contains("without TLS"))
        await running
        assert(!fake.transcript().contains("C: AUTH"))
        return
    }
    assert(false)
}

// The SHA-256 of tests/assets/cert.pem, which also serves as the client certificate
value TEST_CERT_SHA256 ("3293c3c64f1ec445a7e85a1315d55ae0488773ffeed4c6ab81d3da77d9c5c673")

fn test_asset(name: String) String {
    return __DIR__ + "/assets/" + name
}

// Sends one message to a fake server that wants a client certificate, and returns the
// fingerprint of the certificate it got
fn send_with_certificate(security: smtp.Security, tls: smtp.TlsOptions) String {
    let fake = fake_server()
    fake.implicit_tls = security == smtp.Security.tls
    fake.starttls = security == smtp.Security.starttls
    fake.require_client_certificate = true
    let running = co serve(fake)
    let config = fake_tls_config(fake, security)
    tls.ca_file = test_cert()
    config.tls = tls
    let client = smtp.connect_with(config) ! {
        println(E.message)
        await running
        return ""
    }
    client.send(simple_message()) ! { println(E.message) }
    client.close()
    if await running != "ok" : return ""
    return fake.client_certificate
}

test "TLS: client certificate" {
    assert(send_with_certificate(smtp.Security.tls, .{
        certificate_file: test_cert()
        private_key_file: test_key()
    }) == TEST_CERT_SHA256)
    // STARTTLS, with an encrypted key
    assert(send_with_certificate(smtp.Security.starttls, .{
        certificate_file: test_cert()
        private_key_file: test_asset("key-encrypted.pem")
        key_password: "secret"
    }) == TEST_CERT_SHA256)
    // The key in the certificate file
    assert(send_with_certificate(smtp.Security.tls, .{
        certificate_file: test_asset("cert-and-key.pem")
    }) == TEST_CERT_SHA256)
}

test "TLS: a server that wants a client certificate refuses a client without" {
    let fake = fake_server()
    fake.implicit_tls = true
    fake.require_client_certificate = true
    let running = co serve(fake)
    smtp.connect_with(fake_tls_config(fake, smtp.Security.tls)) ! {
        assert(await running == "TLS handshake failed")
        return
    }
    assert(false)
}

// Connects with a client key that cannot be used, and returns whether that was the error
fn client_key_fails(key_file: String, password: String) bool {
    let fake = fake_server()
    fake.implicit_tls = true
    let running = co serve(fake)
    let config = fake_tls_config(fake, smtp.Security.tls)
    config.tls.certificate_file = test_cert()
    config.tls.private_key_file = key_file
    config.tls.key_password = password
    let client = smtp.connect_with(config) ! {
        let failed = error_is(E.code, tls) && E.message.contains("client certificate")
        await running
        return failed
    }
    client.close()
    await running
    return false
}

test "TLS: client certificate errors" {
    assert(client_key_fails(test_asset("key-encrypted.pem"), "wrong"))
    assert(client_key_fails(test_asset("key-encrypted.pem"), ""))
    assert(client_key_fails(test_asset("other-key.pem"), ""))
    assert(client_key_fails(test_asset("missing.pem"), ""))
}
